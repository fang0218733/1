<view class="container">
  <text class="eyebrow">定制档案</text><text class="title">确认每一份期待</text>
  <view class="subtitle">{{package.name}} · 配置参考价 {{price === null ? '价格待确认' : '¥' + price}}</view>
  <view class="notice">{{complete ? '所有题目已完成，可以确认提交。' : '还有未答题目，点击对应条目补充。'}}{{backendEnabled ? "生成待确认需求单，私聊核对报价与交付安排。" : "本地演示，不收款。"}}</view>
  <view class="card answer" wx:for="{{rows}}" wx:key="id" bindtap="edit" data-index="{{item.index}}">
    <view class="muted">{{item.index + 1}} · {{item.category}} · {{submitted ? '已提交快照' : '点击修改'}}</view>
    <view class="section">{{item.title}}</view><view class="{{item.missing ? 'error' : 'value'}}">{{item.answer}}</view>
  </view>
  <view class="card">
    <view class="badge">最后一步 · 按你的心意</view>
    <view class="section">作品方向标签</view><view class="muted">BG 男女向 · GL 女女向 · BL 男男向</view>
    <view class="row"><button wx:for="{{relationships}}" wx:key="*this" class="{{relationship === item ? 'primary' : 'secondary'}}" data-value="{{item}}" bindtap="relationship" disabled="{{submitted}}">{{item}}</button></view>
    <view class="section">客户具体要求（选填）</view>
    <view class="muted">可补充特别偏好或希望避开的内容，最多500字；不填也可以提交。请勿填写密码或联系方式。</view>
    <textarea class="requirements" maxlength="500" value="{{requirements}}" bindinput="requirements" disabled="{{submitted}}" placeholder="例如：希望语气自然，少用昵称，偏爱雨天的书店剧情。" />
    <view class="muted">{{requirements.length}} / 500</view>
    <view class="price">{{price === null ? '价格待确认' : '¥' + price}} <text class="muted">{{privateOrder ? '私人定制' : '普通定制'}} · 需求确认前不标记付款</text></view>
  </view>
  <view class="notice">{{backendEnabled ? '问卷保存至服务端，仅用于私聊核对和人工制作；不收集支付密码或银行卡资料。' : '演示数据仅保存至本机。'}}请勿填写真实敏感信息。私人定制始终不公开。</view>
  <view class="card"><view class="section">成品公开范围</view>
    <view wx:if="{{privateOrder}}" class="notice">私人定制固定仅自己可见，不能公开到免费大厅。</view>
    <radio-group wx:else bindchange="publication">
      <label class="publication-option"><radio value="public" checked="{{publicationChoice === 'public'}}" disabled="{{submitted}}" color="#607f70"/>公开到免费大厅<view class="muted">同意管理员人工审核后发布最终成品，其他客户可以查看、复制和下载。问卷、凭证和具体要求不公开。</view></label>
      <label class="publication-option"><radio value="hidden" checked="{{publicationChoice === 'hidden'}}" disabled="{{submitted}}" color="#607f70"/>仅自己可见<view class="muted">只在本人需求单领取，管理员不能发布到大厅；不因选择不公开而自动改套餐或加价。</view></label>
    </radio-group><view class="muted">提交前可修改选择。提交后授权随需求单保存，不由付款状态决定。</view>
  </view>
  <view class="error" wx:if="{{error}}">{{error}}</view>
  <button class="primary" bindtap="submit" disabled="{{!complete || busy || submitted}}" loading="{{busy}}">{{submitted ? '已提交，可从首页开启新定制' : (backendEnabled ? '生成待确认需求单' : '确认提交演示订单')}}</button>
</view>
