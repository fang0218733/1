<view class="container"><text class="eyebrow">我的需求单</text><text class="title">每一份期待，都有记录</text>
<view class="notice">{{backendEnabled ? '私聊核对编号、报价和交付安排；提交不代表已付款。收款由管理员核实，成品人工制作交付。' : '仅本地模拟，不代表真实收款、管理员权限或跨设备同步。示例状态均为演示。'}}</view>
<view class="filters"><button wx:for="{{filters}}" wx:key="*this" class="{{active === item ? 'primary' : 'secondary'}}" bindtap="select" data-status="{{item}}">{{item}}</button></view>
<view class="card" wx:for="{{orders}}" wx:key="id"><view class="badge">{{item.demo ? '模拟 · ' : ''}}{{item.name}}</view><view class="muted">编号 {{item.id}}</view><view class="muted">创建 {{item.date}} · 题库 {{item.questionVersion}}</view>
<view class="badge">{{item.publicationChoice === "public" ? "允许审核后公开" : "仅自己可见 / 未明确授权公开"}}</view>
<view class="section">付款：{{item.paymentStatus || '历史状态待人工核对'}}</view><view class="section">制作：{{item.productionStatus || '历史状态待人工核对'}}</view>
<view class="muted">提交时报价：{{item.quoteSnapshot ? (item.quoteSnapshot.amount == null ? '价格待确认' : '¥' + item.quoteSnapshot.amount) : '历史报价待核对'}}</view><view wx:if="{{item.agreedQuote}}" class="muted">双方约定报价：¥{{item.agreedQuote.amount}}</view>
<view wx:if="{{item.terms.deliveryAt}}" class="notice">约定交付：{{item.terms.deliveryAt}}<view>修改次数：{{item.terms.revisions}}</view><view>退款条件：{{item.terms.refundConditions}}</view></view>
<view wx:if="{{item.evidence}}" class="notice">凭证：{{item.evidence.status}} · {{item.evidence.submittedAt}}</view><button wx:if="{{item.paymentStatus === '待确认' || item.paymentStatus === '待付款'}}" class="secondary" bindtap="evidence" data-id="{{item.id}}">提交 / 更新支付凭证</button>
<view wx:if="{{item.type === 'card' && item.productionStatus === '已交付'}}" class="notice">下载授权已开放。返回角色大厅，可复制或导出这张角色卡。</view>
<button class="secondary" bindtap="copyDemand" data-id="{{item.id}}">复制需求单，方便私聊核对</button>
<button wx:if="{{item.productionStatus === '已交付' && item.type !== 'card'}}" class="primary" bindtap="bundle" data-id="{{item.id}}">下载 / 导出完整交付ZIP文件包</button><view wx:if="{{item.deliverySchema}}" class="muted">文件内容：<text wx:for="{{item.deliverySchema}}" wx:for-item="part" wx:key="key">{{part.label}}　</text></view>
<view wx:if="{{item.productionStatus === '已交付'}}" class="persona">{{item.card}}</view><button wx:if="{{item.productionStatus === '已交付'}}" class="primary" bindtap="copy" data-id="{{item.id}}">复制人物设定摘要</button>
</view><view wx:if="{{!orders.length}}" class="card muted">暂无需求单</view><view wx:if="{{error}}" class="error">{{error}}</view><button class="secondary" bindtap="home">前往定制</button></view>
