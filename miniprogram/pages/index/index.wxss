.container { padding: 80rpx 36rpx; }
.card { background: #fff; border-radius: 32rpx; padding: 48rpx 36rpx; box-shadow: 0 16rpx 48rpx rgba(23,43,77,0.06); }
.eyebrow { display: block; font-size: 24rpx; color: #66758c; margin-bottom: 24rpx; }
.title { display: block; font-size: 44rpx; line-height: 1.5; font-weight: 600; }
.description { display: block; font-size: 28rpx; color: #66758c; margin: 24rpx 0 48rpx; }
.primary { background: #2459ef; color: #fff; border-radius: 18rpx; font-size: 30rpx; }
.hint { display: block; text-align: center; margin-top: 24rpx; font-size: 24rpx; color: #66758c; }
